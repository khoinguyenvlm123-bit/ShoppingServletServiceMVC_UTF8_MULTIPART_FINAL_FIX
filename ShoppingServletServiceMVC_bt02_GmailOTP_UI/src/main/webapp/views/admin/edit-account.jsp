<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %><%@ page import="vn.iotstar.entity.User" %><!DOCTYPE html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/admin.css"></head><body><div class="app"><header class="topbar"><div class="brand">Dashboard</div><a class="logout" href="<%=request.getContextPath()%>/logout">Đăng xuất</a></header><aside class="sidebar"><div class="profile"><div class="avatar">AD</div><div class="role">Bạn là Admin</div></div><nav class="menu"><a href="<%=request.getContextPath()%>/admin/home">Dashboard</a><div class="menu-title dark">Quản lý Danh mục</div><div class="submenu"><a href="<%=request.getContextPath()%>/admin/category/add">Thêm danh mục mới</a><a href="<%=request.getContextPath()%>/admin/category/list">Danh sách danh mục</a></div><a href="<%=request.getContextPath()%>/admin/product/list">Quản lý sản phẩm</a><a href="<%=request.getContextPath()%>/admin/account/list">Quản lý tài khoản</a></nav></aside><%User u=(User)request.getAttribute("account");%><main class="content"><section class="card form-card"><div class="card-body"><h1 class="page-title">Sửa tài khoản</h1><form method="post"><input type="hidden" name="id" value="<%=u.getId()%>"><label>Username</label><input class="input" name="username" value="<%=u.getUserName()%>" required><label>Mật khẩu mới (để trống nếu giữ nguyên)</label><input class="input" type="password" name="password"><label>Họ tên</label><input class="input" name="fullname" value="<%=u.getFullName()%>" required><label>Email</label><input class="input" type="email" name="email" value="<%=u.getEmail()%>" required><label>Điện thoại</label><input class="input" name="phone" value="<%=u.getPhone()%>" required><label>Vai trò</label><select class="input" name="roleid"><option value="5" <%=u.getRoleid()!=1?"selected":""%>>User</option><option value="1" <%=u.getRoleid()==1?"selected":""%>>Admin</option></select><br><button class="btn btn-primary">Cập nhật</button> <a class="btn" href="<%=request.getContextPath()%>/admin/account/list">Hủy</a></form></div></section></main></div></body></html>