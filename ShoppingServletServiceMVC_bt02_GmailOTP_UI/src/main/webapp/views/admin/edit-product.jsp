<%@ page contentType="text/html;charset=UTF-8" language="java" pageEncoding="UTF-8" %><%@ page import="vn.iotstar.entity.Product" %><!DOCTYPE html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/admin.css"></head><body><div class="app"><header class="topbar"><div class="brand">Dashboard</div><a class="logout" href="<%=request.getContextPath()%>/logout">Đăng xuất</a></header><aside class="sidebar"><div class="profile"><div class="avatar">AD</div><div class="role">Bạn là Admin</div></div><nav class="menu"><a href="<%=request.getContextPath()%>/admin/home">Dashboard</a><div class="menu-title dark">Quản lý Danh mục</div><div class="submenu"><a href="<%=request.getContextPath()%>/admin/category/add">Thêm danh mục mới</a><a href="<%=request.getContextPath()%>/admin/category/list">Danh sách danh mục</a></div><a href="<%=request.getContextPath()%>/admin/product/list">Quản lý sản phẩm</a><a href="<%=request.getContextPath()%>/admin/account/list">Quản lý tài khoản</a></nav></aside><% Product x=(Product)request.getAttribute("product"); %><main class="content"><section class="card form-card"><div class="card-body"><h1 class="page-title">Sửa sản phẩm</h1><form method="post"><input type="hidden" name="id" value="<%=x.getId()%>"><label>Tên sản phẩm</label><input class="input" name="name" value="<%=x.getName()%>" required><label>Danh mục</label><select class="input" name="categoryId"><% java.util.List<vn.iotstar.entity.Category> cs=(java.util.List<vn.iotstar.entity.Category>)request.getAttribute("categories");if(cs!=null)for(vn.iotstar.entity.Category c:cs){%><option value="<%=c.getId()%>" <%=x.getCategory()!=null&&x.getCategory().getId()==c.getId()?"selected":""%>><%=c.getName()%></option><%}%></select><label>Giá</label><input class="input" type="number" step="0.01" min="0" name="price" value="<%=x.getPrice()%>" required><label>Số lượng</label><input class="input" type="number" min="0" name="quantity" value="<%=x.getQuantity()%>" required><label>Link/tên hình ảnh</label><input class="input" name="image" value="<%=x.getImage()==null?"":x.getImage()%>"><label>Mô tả</label><textarea class="input" name="description"><%=x.getDescription()==null?"":x.getDescription()%></textarea><br><button class="btn btn-primary">Cập nhật</button> <a class="btn" href="<%=request.getContextPath()%>/admin/product/list">Hủy</a></form></div></section></main></div></body></html>